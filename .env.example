# Copy this file to .env.local and fill in the values.
# Never put real keys in .env.example. Never commit .env.local.

# --- Site ---
# The public address of the site. On your computer keep this as it is.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "production" ONLY on the real live site. Anything else shows the "Demo data" banner.
NEXT_PUBLIC_SITE_ENV=development

# --- Supabase ---
# Supabase dashboard -> Project Settings -> API Keys. See README.md, "Set up Supabase".
# The project address. It looks like https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key. It starts with sb_publishable_ and is safe to show in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The "secret" key. It starts with sb_secret_ . Server only. Never share it.
# Never give it a name that starts with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Feature flags ---
# Phone sign-in costs money per SMS. Keep "false" unless you decide to pay for it.
NEXT_PUBLIC_FEATURE_PHONE_OTP=false
