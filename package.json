{
  "name": "consultancy-reviews",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test",
    "tokens": "tsx scripts/build-tokens.ts",
    "palette": "tsx scripts/palette-explore.ts",
    "seed:build": "tsx scripts/generate-seed.ts",
    "import": "tsx scripts/import-consultancies.ts",
    "db:start": "supabase start -x realtime,imgproxy,mailpit,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "db:reset": "supabase db reset",
    "db:stop": "supabase stop"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.6",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@types/mdx": "^2.0.14",
    "dictionary-of-colour-combinations": "^1.0.2",
    "lucide-react": "^1.73.0",
    "nepali-date-converter": "^3.4.2",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
